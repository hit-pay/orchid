{
  "name": "orchidui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore --fix packages",
    "format": "prettier .  --write",
    "dev": "storybook dev -p 6006",
    "dev:landing": "vite dev",
    "dev:mcp": "cd mcp-server && node --watch server.js",
    "mcp": "cd mcp-server && node server.js",
    "test": "vitest",
    "preview": "npx serve dist ",
    "build:core": "cd packages/core && npm run build",
    "build:dashboard": "npm install && cd packages/dashboard && npm run build",
    "build:storybook": "storybook build -o public/storybook",
    "build:json": "cd json && node build-json.js && node ../generate-llms.mjs",
    "build:landing": "vite build",
    "build": "npm run build:core && npm run build:dashboard && npm install && npm run build:storybook && npm run build:json && npm run build:landing",
    "publish-dev:core": "npm run build:core && cd packages/core && npm publish --tag beta",
    "publish-dev:dashboard": "npm run build:dashboard && cd packages/dashboard && npm publish --tag beta",
    "release": "bun run release.js"
  },
  "dependencies": {
    "dayjs": "^1.11.23",
    "vue-router": "~5.0.7"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/addon-interactions": "^8.6.19",
    "@storybook/addon-links": "^8.6.19",
    "@storybook/blocks": "^8.6.19",
    "@storybook/testing-library": "^0.2.2",
    "@storybook/vue3": "^8.6.19",
    "@storybook/vue3-vite": "^8.6.19",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "eslint-config-prettier": "^9.1.2",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-vue": "^9.33.0",
    "fast-glob": "^3.3.3",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.32",
    "postcss-import": "^15.1.0",
    "sass": "^1.107.0",
    "storybook": "^8.6.19",
    "storybook-addon-root-attribute": "^1.0.2",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "vue": "^3.5.44"
  },
  "overrides": {
    "lodash": ">=4.17.23",
    "mdast-util-to-hast": ">=13.2.1",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": "^24.22.1 || >=26.12.1",
    "npm": ">=11"
  }
}
